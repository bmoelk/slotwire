{
  "name": "astro-slotwire",
  "version": "0.1.0",
  "description": "Astro integration for SlotWire with visual in-situ Dev Toolbar and build-time validation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./SlotWire.astro": "./src/SlotWire.astro",
    "./GhostSlot.astro": "./src/GhostSlot.astro",
    "./ChecklistHUD.astro": "./src/ChecklistHUD.astro",
    "./PreCreateModal.astro": "./src/PreCreateModal.astro",
    "./deep-link": {
      "types": "./dist/deep-link.d.ts",
      "import": "./dist/deep-link.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@slotwire/core": "file:../core"
  },
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "astro": "^5.0.0",
    "typescript": "^5.5.4"
  },
  "license": "MIT"
}
