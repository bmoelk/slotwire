---
import { INSPECTOR_CSS, renderInspectorHtml } from './inspector-core.js';

export interface Props {
  adminUrl?: string;
  assistActive?: boolean;
}

const {
  adminUrl = '/admin',
  assistActive = true,
} = Astro.props;

const envVar =
  (typeof process !== 'undefined' && process.env?.ENVIRONMENT) ||
  (import.meta as any).env?.ENVIRONMENT ||
  (typeof process !== 'undefined' && process.env?.ASTRO_STAGING);
const isStaging = envVar === 'staging' || envVar === 'true';

const isAssistMode =
  assistActive &&
  (isStaging ||
    Astro.url.searchParams.get('slotwire_assist') === 'true' ||
    Astro.url.searchParams.get('slotwire_preview') === 'true' ||
    Astro.url.hostname.startsWith('edit.') ||
    Astro.url.hostname.includes('staging') ||
    Boolean(import.meta.env.DEV));

const envTag = isStaging ? 'STAGING' : 'DEV';
---

{isAssistMode && (
  <div id="slotwire-assist-container" class="slotwire-assist-container" data-admin-url={adminUrl} data-env-tag={envTag}>
    <!-- Compact Draggable Assist Pill -->
    <div id="slotwire-assist-bubble" class="slotwire-assist-bubble" title="SlotWire Assist (Hover or click to inspect)">
      <span id="sw-pill-drag" class="sw-pill-drag" title="Drag to reposition">⋮⋮</span>
      <span class="sw-pulse-dot"></span>
      <span class="sw-assist-label">SlotWire</span>
      <span id="sw-slot-count" class="sw-slot-count">0</span>
    </div>

    <!-- Unified Inspector Drawer / Popup -->
    <div id="slotwire-inspector-modal" class="slotwire-inspector-modal">
      <Fragment set:html={renderInspectorHtml({ adminUrl, envTag, provider: 'slottd', showCloseBtn: true, showRequestSlotBtn: true })} />
    </div>
  </div>
)}

<style is:global set:html={`
  ${INSPECTOR_CSS}

  .slotwire-assist-container {
    position: fixed;
    z-index: 999990;
    pointer-events: none;
  }

  /* Compact Draggable Pill */
  .slotwire-assist-bubble {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999990;
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(9, 9, 11, 0.94);
    border: 1px solid rgba(39, 39, 42, 0.9);
    backdrop-filter: blur(14px);
    border-radius: 9999px;
    box-shadow: 0 12px 30px -4px rgba(0, 0, 0, 0.6), 0 4px 12px -2px rgba(0, 0, 0, 0.4);
    color: #f4f4f5;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .slotwire-assist-bubble:hover {
    border-color: #10b981;
    box-shadow: 0 14px 35px -4px rgba(16, 185, 129, 0.25);
  }

  .sw-pill-drag {
    cursor: grab;
    color: #71717a;
    font-size: 13px;
    line-height: 1;
    padding: 2px 4px;
    margin-left: -2px;
    user-select: none;
    touch-action: none;
    transition: color 0.15s ease;
  }
  .sw-pill-drag:hover {
    color: #10b981;
  }
  .sw-pill-drag:active {
    cursor: grabbing;
  }

  .sw-pulse-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
    animation: sw-pill-pulse 2s infinite ease-in-out;
  }
  @keyframes sw-pill-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  .sw-assist-label {
    letter-spacing: 0.02em;
    color: #fafafa;
  }

  .sw-slot-count {
    background: rgba(16, 185, 129, 0.2);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 9999px;
  }

  /* Elegant Smooth Transition for Inspector Modal */
  .slotwire-inspector-modal {
    position: fixed;
    z-index: 999995;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px) scale(0.98);
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .slotwire-inspector-modal.sw-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
`} />

<script>
  import { initInspector, startVisualElementPicker } from './inspector-core.js';

  function setupAssistPill() {
    const container = document.getElementById('slotwire-assist-container');
    const bubble = document.getElementById('slotwire-assist-bubble');
    const modal = document.getElementById('slotwire-inspector-modal');
    const dragHandle = document.getElementById('sw-pill-drag');
    const countBadge = document.getElementById('sw-slot-count');

    if (!container || !bubble || !modal) return;

    const adminUrl = container.dataset.adminUrl || '/admin';
    const envTag = container.dataset.envTag || 'DEV';

    let isLockedOpen = false;
    let isDragging = false;
    let hoverTimer: any = null;
    let hideTimer: any = null;

    // 1. Position Modal cleanly above or below bubble (Never Overlapping)
    function updateModalPosition() {
      if (!bubble || !modal) return;
      const rect = bubble.getBoundingClientRect();
      const modalWidth = 440;
      const gap = 12;

      // Horizontal positioning: align right edge with bubble, stay within screen
      let left = rect.right - modalWidth;
      if (left < 16) left = 16;
      if (left + modalWidth > window.innerWidth - 16) {
        left = window.innerWidth - modalWidth - 16;
      }
      modal.style.left = `${Math.round(left)}px`;
      modal.style.right = 'auto';

      // Vertical positioning:
      // If pill is in bottom half of viewport -> dock ABOVE pill (never overlaps)
      if (rect.top > window.innerHeight / 2) {
        const bottomDistance = window.innerHeight - rect.top + gap;
        modal.style.bottom = `${Math.round(bottomDistance)}px`;
        modal.style.top = 'auto';
      } else {
        // Pill is in top half -> dock BELOW pill
        const topDistance = rect.bottom + gap;
        modal.style.top = `${Math.round(topDistance)}px`;
        modal.style.bottom = 'auto';
      }
    }

    function openInspector() {
      clearTimeout(hideTimer);
      clearTimeout(hoverTimer);
      updateModalPosition();
      modal.classList.add('sw-open');
    }

    function scheduleCloseInspector() {
      if (isLockedOpen) return;
      clearTimeout(hoverTimer);
      hideTimer = setTimeout(() => {
        if (!isLockedOpen) {
          modal.classList.remove('sw-open');
        }
      }, 280);
    }

    function closeInspectorImmediately() {
      isLockedOpen = false;
      clearTimeout(hoverTimer);
      clearTimeout(hideTimer);
      modal.classList.remove('sw-open');
    }

    // 2. Deliberate Hover Trigger with 280ms threshold (Prevents Accidental Triggers)
    bubble.addEventListener('mouseenter', (e) => {
      if (isDragging || isLockedOpen) return;
      // If entering directly onto the drag handle, do not start hover open
      if ((e.target as HTMLElement).closest('#sw-pill-drag')) return;

      clearTimeout(hideTimer);
      hoverTimer = setTimeout(() => {
        if (!isDragging) {
          openInspector();
        }
      }, 280);
    });

    bubble.addEventListener('mouseleave', () => {
      clearTimeout(hoverTimer);
      scheduleCloseInspector();
    });

    modal.addEventListener('mouseenter', () => {
      clearTimeout(hideTimer);
    });

    modal.addEventListener('mouseleave', () => {
      scheduleCloseInspector();
    });

    // 3. Click Triggers (Lock / Unlock open)
    bubble.addEventListener('click', (e) => {
      // Ignore click on drag handle
      if ((e.target as HTMLElement).closest('#sw-pill-drag')) return;
      clearTimeout(hoverTimer);

      isLockedOpen = !isLockedOpen;
      if (isLockedOpen) {
        openInspector();
      } else {
        closeInspectorImmediately();
      }
    });

    // 4. Drag & Drop Repositioning
    let dragStartX = 0;
    let dragStartY = 0;
    let bubbleInitialLeft = 0;
    let bubbleInitialTop = 0;

    // Restore saved position from localStorage
    const savedPos = localStorage.getItem('slotwire_pill_pos');
    if (savedPos) {
      try {
        const { top, left } = JSON.parse(savedPos);
        bubble.style.top = `${top}px`;
        bubble.style.left = `${left}px`;
        bubble.style.bottom = 'auto';
        bubble.style.right = 'auto';
      } catch {}
    }

    if (dragHandle) {
      // While mouse is directly on the drag handle, cancel any hover open
      dragHandle.addEventListener('mouseenter', () => {
        clearTimeout(hoverTimer);
      });

      dragHandle.addEventListener('mousedown', (e) => {
        isDragging = true;
        clearTimeout(hoverTimer);
        if (!isLockedOpen) {
          closeInspectorImmediately();
        }

        dragStartX = e.clientX;
        dragStartY = e.clientY;
        const rect = bubble.getBoundingClientRect();
        bubbleInitialLeft = rect.left;
        bubbleInitialTop = rect.top;
        bubble.style.bottom = 'auto';
        bubble.style.right = 'auto';
        bubble.style.left = `${bubbleInitialLeft}px`;
        bubble.style.top = `${bubbleInitialTop}px`;
        document.body.style.userSelect = 'none';
        e.preventDefault();
        e.stopPropagation();
      });

      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - dragStartX;
        const dy = e.clientY - dragStartY;
        const newLeft = Math.max(12, Math.min(window.innerWidth - bubble.offsetWidth - 12, bubbleInitialLeft + dx));
        const newTop = Math.max(12, Math.min(window.innerHeight - bubble.offsetHeight - 12, bubbleInitialTop + dy));
        bubble.style.left = `${newLeft}px`;
        bubble.style.top = `${newTop}px`;
        updateModalPosition();
      });

      document.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          document.body.style.userSelect = '';
          const rect = bubble.getBoundingClientRect();
          localStorage.setItem('slotwire_pill_pos', JSON.stringify({ top: Math.round(rect.top), left: Math.round(rect.left) }));
          updateModalPosition();
        }
      });
    }

    // 5. Initialize Shared Inspector Inside Modal
    initInspector(modal, {
      adminUrl,
      envTag,
      provider: 'slottd',
      showCloseBtn: true,
      showRequestSlotBtn: true,
      onRequestSlot: () => {
        closeInspectorImmediately();
        startVisualElementPicker(() => {
          openInspector();
        });
      },
      onClose: () => {
        closeInspectorImmediately();
      },
      onSlotCountChange: (count) => {
        if (countBadge) countBadge.textContent = String(count);
      },
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeInspectorImmediately();
      }
    });

    // Close on click outside modal
    document.addEventListener('click', (e) => {
      if (
        isLockedOpen &&
        modal.classList.contains('sw-open') &&
        !modal.contains(e.target as Node) &&
        !bubble.contains(e.target as Node)
      ) {
        closeInspectorImmediately();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupAssistPill);
  document.addEventListener('astro:page-load', setupAssistPill);
  setupAssistPill();
</script>
