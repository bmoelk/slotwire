---
export interface Props {
  adminUrl?: string;
  editor?: 'markdown' | 'html';
}

const { adminUrl = '/admin', editor = 'markdown' } = Astro.props;

const envVar =
  (typeof process !== 'undefined' && process.env?.ENVIRONMENT) ||
  (import.meta as any).env?.ENVIRONMENT ||
  (typeof process !== 'undefined' && process.env?.ASTRO_STAGING);
const isStaging = envVar === 'staging' || envVar === 'true';

const isPreview =
  Boolean(import.meta.env.DEV) ||
  isStaging ||
  Astro.url.searchParams.get('slotwire_assist') === 'true' ||
  Astro.url.searchParams.get('slotwire_preview') === 'true' ||
  Astro.url.hostname.startsWith('edit.') ||
  Astro.url.hostname.includes('staging');
---

{isPreview && (
  <div id="slotwire-quick-drawer-root" data-admin-url={adminUrl} data-editor={editor}>
    <!-- Semi-transparent backdrop -->
    <div
      id="slotwire-quick-drawer-backdrop"
      class="sw-quick-backdrop"
      aria-hidden="true"
    ></div>

    <!-- Slide-over Edit Drawer -->
    <aside
      id="slotwire-quick-edit-drawer"
      class="sw-quick-drawer"
      aria-label="SlotWire Quick Edit"
    >
      <!-- Drawer Header -->
      <div class="sw-quick-header">
        <div class="sw-quick-header-title">
          <span class="sw-quick-icon-badge">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25a1.75 1.75 0 0 1 .445-.758l8.61-8.61Zm1.414 1.06a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354l-1.086-1.086ZM11.189 6.25 9.75 4.81l-6.286 6.287a.25.25 0 0 0-.064.108l-.558 1.953 1.953-.558a.249.249 0 0 0 .108-.064l6.286-6.286Z"/>
            </svg>
          </span>
          <div>
            <div style="display: flex; align-items: center; gap: 6px;">
              <h2 class="sw-quick-h2">Quick Edit</h2>
              <span id="sw-quick-slot-badge" class="sw-quick-badge">slot</span>
            </div>
            <p id="sw-quick-doc-id" class="sw-quick-doc-id">doc: --</p>
          </div>
        </div>

        <button
          id="sw-quick-close-btn"
          type="button"
          class="sw-quick-close-btn"
          aria-label="Close drawer"
        >
          ✕
        </button>
      </div>

      <!-- Drawer Form -->
      <form id="sw-quick-edit-form" class="sw-quick-form">
        <!-- Scrollable Fields Area -->
        <div id="sw-quick-fields-container" class="sw-quick-fields">
          <div style="color: #71717a; text-align: center; padding: 32px 0;">
            Click [Quick Edit] on any slot overlay to edit in-situ.
          </div>
        </div>

        <!-- Error Banner -->
        <div
          id="sw-quick-error"
          class="sw-quick-error"
          style="display: none;"
        ></div>

        <!-- Drawer Footer -->
        <div class="sw-quick-footer">
          <a
            id="sw-quick-escape-hatch"
            href={`${adminUrl.replace(/\/+$/, '')}/content`}
            target="_blank"
            rel="noopener noreferrer"
            class="sw-quick-escape"
            title="Open full CMS studio for advanced layout, tables, or relational editing"
          >
            <span>Open Full Studio ↗</span>
          </a>

          <div style="display: flex; align-items: center; gap: 8px;">
            <button
              type="button"
              id="sw-quick-cancel-btn"
              class="sw-quick-cancel-btn"
            >
              Cancel
            </button>

            <button
              type="submit"
              id="sw-quick-save-btn"
              class="sw-quick-save-btn"
            >
              <span>💾 Save Draft</span>
            </button>
          </div>
        </div>
      </form>
    </aside>
  </div>

  <style is:global>
    #slotwire-quick-drawer-backdrop {
      position: fixed;
      inset: 0;
      z-index: 999990;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(4px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.25s ease, visibility 0.25s ease;
      display: none;
    }
    #slotwire-quick-drawer-backdrop.sw-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      display: block !important;
    }

    #slotwire-quick-edit-drawer {
      position: fixed;
      top: 0;
      right: 0;
      z-index: 999995;
      height: 100vh;
      width: 100%;
      max-width: 440px;
      background: #09090b !important;
      border-left: 1px solid #27272a;
      color: #f4f4f5;
      box-shadow: -10px 0 35px rgba(0, 0, 0, 0.85);
      display: flex;
      flex-direction: column;
      transform: translateX(100%) !important;
      visibility: hidden;
      pointer-events: none;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 12px;
      box-sizing: border-box;
    }
    #slotwire-quick-edit-drawer.sw-open {
      transform: translateX(0) !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }

    #slotwire-quick-edit-drawer * {
      box-sizing: border-box;
    }

    .sw-quick-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      border-bottom: 1px solid #27272a;
      background: rgba(24, 24, 27, 0.7);
    }
    .sw-quick-header-title {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .sw-quick-icon-badge {
      display: inline-flex;
      width: 24px;
      height: 24px;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .sw-quick-h2 {
      font-size: 11px;
      font-weight: 700;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin: 0;
    }
    .sw-quick-badge {
      font-family: ui-monospace, monospace;
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 4px;
      background: #27272a;
      color: #d4d4d8;
    }
    .sw-quick-doc-id {
      font-size: 11px;
      color: #a1a1aa;
      margin: 2px 0 0 0;
      max-width: 240px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .sw-quick-close-btn {
      background: transparent;
      border: none;
      border-radius: 6px;
      padding: 6px 8px;
      color: #a1a1aa;
      cursor: pointer;
      font-size: 14px;
      line-height: 1;
      transition: background 0.15s, color 0.15s;
    }
    .sw-quick-close-btn:hover {
      background: #27272a;
      color: #fff;
    }
    .sw-quick-form {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .sw-quick-fields {
      flex: 1;
      overflow-y: auto;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .sw-quick-fields input[type="text"],
    .sw-quick-fields textarea {
      width: 100%;
      background: #18181b;
      border: 1px solid #3f3f46;
      border-radius: 6px;
      padding: 8px 10px;
      color: #f4f4f5;
      font-size: 12px;
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s;
      box-sizing: border-box;
    }
    .sw-quick-fields textarea {
      font-family: ui-monospace, monospace;
      line-height: 1.5;
      resize: vertical;
    }
    .sw-quick-fields input[type="text"]:focus,
    .sw-quick-fields textarea:focus {
      border-color: #10b981;
    }
    .sw-quick-error {
      margin: 0 18px 10px;
      padding: 10px 12px;
      border-radius: 6px;
      background: rgba(244, 63, 94, 0.1);
      border: 1px solid rgba(244, 63, 94, 0.3);
      color: #fb7185;
      font-size: 12px;
    }
    .sw-quick-footer {
      padding: 12px 18px;
      border-top: 1px solid #27272a;
      background: rgba(24, 24, 27, 0.5);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .sw-quick-escape {
      font-size: 11px;
      color: #a1a1aa;
      text-decoration: underline;
      text-underline-offset: 2px;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .sw-quick-escape:hover {
      color: #34d399;
    }
    .sw-quick-cancel-btn {
      background: #27272a;
      border: none;
      border-radius: 6px;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 600;
      color: #d4d4d8;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }
    .sw-quick-cancel-btn:hover {
      background: #3f3f46;
      color: #fff;
    }
    .sw-quick-save-btn {
      background: #059669;
      border: none;
      border-radius: 6px;
      padding: 6px 14px;
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.2);
      transition: background 0.15s, transform 0.1s;
    }
    .sw-quick-save-btn:hover {
      background: #10b981;
    }
    .sw-quick-save-btn:active {
      transform: scale(0.98);
    }
  </style>

  <script>
    import { initQuickEditDrawer } from './client.js';

    function setupQuickDrawer() {
      const root = document.getElementById('slotwire-quick-drawer-root');
      if (!root) return;
      const adminUrl = root.dataset.adminUrl || '/admin';
      const editor = (root.dataset.editor as 'markdown' | 'html') || 'markdown';
      initQuickEditDrawer({ adminUrl, editor });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupQuickDrawer);
    } else {
      setupQuickDrawer();
    }
    document.addEventListener('astro:page-load', setupQuickDrawer);
    document.addEventListener('astro:after-swap', setupQuickDrawer);
  </script>
)}
