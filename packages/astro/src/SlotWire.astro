---
import type { SlotArchetype } from '@slotwire/core';
import GhostSlot from './GhostSlot.astro';
import { buildCmsDeepLink } from './deep-link.js';

export interface Props {
  slot: string;
  archetype?: SlotArchetype;
  collection?: string;
  pageSlug?: string;
  sectionKey?: string;
  documentId?: string;
  data?: any;
  required?: boolean;
  isFallback?: boolean;
  adminUrl?: string;
  provider?: string;
  staticTagging?: boolean;
  as?: string;
  class?: string;
  badgePosition?: 'top-right' | 'bottom-right' | 'bottom-left' | 'top-left';
}

const {
  slot,
  archetype,
  collection = slot,
  pageSlug,
  sectionKey,
  documentId,
  data,
  required = false,
  isFallback = false,
  adminUrl: propAdminUrl,
  provider: propProvider,
  staticTagging = true,
  as: Tag = 'div',
  class: className = '',
  badgePosition: propBadgePosition,
} = Astro.props;

const resolvedProvider =
  propProvider ||
  (typeof import.meta !== 'undefined' && (import.meta as any).env?.CMS_PROVIDER) ||
  (typeof process !== 'undefined' && process.env?.CMS_PROVIDER) ||
  'slottd';

const resolvedApiUrl =
  (typeof import.meta !== 'undefined' && (import.meta as any).env?.CMS_API_URL) ||
  (typeof process !== 'undefined' && process.env?.CMS_API_URL);

const defaultAdminUrl =
  resolvedApiUrl ? `${resolvedApiUrl.replace(/\/+$/, '')}/admin` : '/admin';

const adminUrl =
  propAdminUrl ||
  (typeof import.meta !== 'undefined' && (import.meta as any).env?.CMS_ADMIN_URL) ||
  (typeof process !== 'undefined' && process.env?.CMS_ADMIN_URL) ||
  defaultAdminUrl;

const provider = resolvedProvider;

// Kill Switch Check (Controlled via prop or environment variable)
const isTaggingEnabled =
  staticTagging !== false &&
  import.meta.env.SLOTWIRE_DISABLE_TAGS !== 'true' &&
  (globalThis as any).process?.env?.SLOTWIRE_DISABLE_TAGS !== 'true';

const envVar =
  (typeof process !== 'undefined' && process.env?.ENVIRONMENT) ||
  (import.meta as any).env?.ENVIRONMENT ||
  (typeof process !== 'undefined' && process.env?.ASTRO_STAGING);
const isStaging = envVar === 'staging' || envVar === 'true';

// Dynamic Preview / Assist Mode Detection (Local Dev, Staging, or Query Params)
const isPreview =
  Boolean(import.meta.env.DEV) ||
  isStaging ||
  Astro.url.searchParams.get('slotwire_assist') === 'true' ||
  Astro.url.searchParams.get('slotwire_preview') === 'true' ||
  Astro.url.hostname.startsWith('edit.') ||
  Astro.url.hostname.includes('staging');

// Determine if data payload is missing or empty
const isMissing =
  data === undefined ||
  data === null ||
  data === '' ||
  (Array.isArray(data) && data.length === 0) ||
  (typeof data === 'object' && Object.keys(data).length === 0);

// ── Server-Side Page Boundary Tracking ─────────────────────────────────────────
if (typeof globalThis !== 'undefined') {
  const currentPath = Astro.url.pathname;
  const g = globalThis as any;
  if (!g.__slotwire_session || g.__slotwire_session.route !== currentPath) {
    g.__slotwire_session = {
      route: currentPath,
      startTime: performance.now(),
      slots: new Set<string>(),
      populatedSlots: new Set<string>(),
      missingSlots: new Set<string>(),
    };
  }
  g.__slotwire_session.slots.add(slot);
  if (isMissing) {
    g.__slotwire_session.missingSlots.add(slot);
  } else {
    g.__slotwire_session.populatedSlots.add(slot);
  }
}

// Determine cardinality and resolve document ID
const isArray = Array.isArray(data);
const resolvedDocId = documentId || (!isArray ? (data?.id || data?.rootId || data?.root_id) : undefined);
const resolvedCollection = collection || archetype || slot;

// Introspect Child Documents for Composite Slots
const childItems = isArray
  ? (data as any[]).map((item: any, idx: number) => {
      const id = item?.id || item?.rootId || item?.slug || item?._id || `item-${idx + 1}`;
      const label = item?.title || item?.name || item?.heading || item?.badgeText || item?.slug || `Item #${idx + 1}`;
      const rawThumb = item?.imageUrl || item?.image || item?.avatarUrl || item?.src || item?.url || item?.coverImage || (item?.localImg?.src) || undefined;
      let thumbnail = rawThumb;
      if (typeof rawThumb === 'string' && rawThumb.startsWith('/') && resolvedApiUrl) {
        thumbnail = `${resolvedApiUrl.replace(/\/+$/, '')}${rawThumb}`;
      }
      const order = item?.order !== undefined ? item.order : idx + 1;
      const editUrl = buildCmsDeepLink({
        provider,
        adminUrl,
        collection: resolvedCollection,
        documentId: item?.id || item?.rootId || item?.slug || item?._id,
        action: 'edit',
        archetype,
        pageSlug,
        sectionKey,
      });
      return { id, label, thumbnail, order, editUrl };
    })
  : [];

const createItemUrl = buildCmsDeepLink({
  provider,
  adminUrl,
  collection: resolvedCollection,
  action: 'create',
  archetype,
  pageSlug,
  sectionKey,
});

const listUrl = buildCmsDeepLink({
  provider,
  adminUrl,
  collection: resolvedCollection,
  action: 'list',
  archetype,
  pageSlug,
  sectionKey,
});

const singleEditUrl = buildCmsDeepLink({
  provider,
  adminUrl,
  collection: resolvedCollection,
  documentId: resolvedDocId,
  pageSlug,
  sectionKey,
  action: isMissing ? 'create' : resolvedDocId ? 'edit' : 'list',
  archetype,
});

const isCollectionSlot =
  archetype === 'cards' ||
  archetype === 'gallery' ||
  archetype === 'testimonials' ||
  archetype === 'endorsements' ||
  archetype === 'qa' ||
  archetype === 'faq' ||
  archetype === 'table' ||
  isArray;

const actionLabel = isCollectionSlot ? 'CMS Table ↗' : 'CMS ↗';
let serializedSlotData: string | undefined;
if (data && typeof data === 'object') {
  try {
    serializedSlotData = JSON.stringify(data);
  } catch {}
}
const serializedItems = childItems.length > 0 ? JSON.stringify(childItems.map(c => ({ id: c.id, label: c.label, thumbnail: c.thumbnail }))) : undefined;

const rawDraftStatus = (data as any)?.draft_status;
const rawStatus = (data as any)?.status;
const isDraftModified = rawDraftStatus === 'modified' || (rawStatus === 'draft' && rawDraftStatus !== 'new');
const isDraftNew = rawDraftStatus === 'new';

const statusBadgeLabel = isFallback
  ? 'Fallback Active'
  : isDraftNew
  ? 'New'
  : isDraftModified
  ? 'Draft Modified'
  : 'Published';

const statusBadgeClass = isFallback
  ? 'sw-status-fallback'
  : isDraftNew
  ? 'sw-status-new'
  : isDraftModified
  ? 'sw-status-modified'
  : 'sw-status-published';

// Auto-position navigation/header badges to bottom-left to prevent covering menu buttons/CTA
const isNavSlot =
  archetype === 'navigation' ||
  archetype === 'navbar' ||
  slot.toLowerCase().includes('nav') ||
  slot.toLowerCase().includes('header') ||
  slot.toLowerCase().includes('menu');

const defaultBadgeCorner = isNavSlot ? 'sw-pos-bl' : 'sw-pos-tr';
const resolvedBadgeCorner = propBadgePosition
  ? (propBadgePosition === 'top-right'
      ? 'sw-pos-tr'
      : propBadgePosition === 'bottom-right'
      ? 'sw-pos-br'
      : propBadgePosition === 'bottom-left'
      ? 'sw-pos-bl'
      : 'sw-pos-tl')
  : defaultBadgeCorner;
---

{isMissing ? (
  isPreview ? (
    <GhostSlot
      slot={slot}
      archetype={archetype}
      collection={resolvedCollection}
      pageSlug={pageSlug}
      sectionKey={sectionKey}
      documentId={resolvedDocId}
      required={required}
      adminUrl={adminUrl}
      provider={provider}
      class={className}
    >
      <slot name="fallback">
        <slot />
      </slot>
    </GhostSlot>
  ) : (
    <slot name="fallback" />
  )
) : isPreview ? (
  <div
    class={`slotwire-slot-container ${className || ''}`}
    data-slotwire-archetype={archetype}
    data-slotwire-slot={slot}
    data-slotwire-collection={resolvedCollection}
    data-slotwire-page={pageSlug}
    data-slotwire-section={sectionKey}
    data-slotwire-id={resolvedDocId}
    data-slotwire-status={statusBadgeLabel}
    data-slotwire-edit-url={isCollectionSlot ? listUrl : singleEditUrl}
    data-slotwire-items={serializedItems}
    data-slotwire-source={isFallback ? 'fallback' : 'cms'}
  >
    {isTaggingEnabled ? (
      <Tag
        data-slotwire-slot={slot}
        data-slotwire-archetype={archetype}
        data-slotwire-collection={resolvedCollection}
        data-slotwire-page={pageSlug}
        data-slotwire-section={sectionKey}
        data-slotwire-id={resolvedDocId}
        data-slotwire-items={serializedItems}
        data-slotwire-source={isFallback ? 'fallback' : 'cms'}
      >
        <slot />
      </Tag>
    ) : (
      <Tag>
        <slot />
      </Tag>
    )}

    <!-- In-Situ Hover Gateway for Populated Slots in Dev / Preview Mode -->
    <div class={`slotwire-in-situ-badge ${resolvedBadgeCorner}`} data-slot-key={slot}>
      <!-- Full Expanded Badge Card -->
      <div class="slotwire-badge-card">
        <!-- Drag Handle -->
        <span class="slotwire-badge-drag" title="Drag to reposition badge">⋮⋮</span>

        {childItems.length > 0 ? (
          <div class="slotwire-composite-gateway">
            <div class="slotwire-edit-btn slotwire-composite-trigger">
              <svg class="slotwire-logo-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="4" width="6" height="16" rx="2.5" fill="#0f172a" stroke="#10b981" stroke-width="1.8"/>
                <rect x="16" y="4" width="6" height="16" rx="2.5" fill="#0f172a" stroke="#06b6d4" stroke-width="1.8"/>
                <circle cx="5" cy="8.5" r="1.2" fill="#10b981"/>
                <circle cx="5" cy="15.5" r="1.2" fill="#10b981"/>
                <circle cx="19" cy="8.5" r="1.2" fill="#06b6d4"/>
                <circle cx="19" cy="15.5" r="1.2" fill="#06b6d4"/>
                <path d="M6.5 8.5H17.5" stroke="#10b981" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M6.5 15.5H17.5" stroke="#06b6d4" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <span>✓ <strong>{slot}</strong></span>
              <span class={`slotwire-status-tag ${statusBadgeClass}`}>{statusBadgeLabel}</span>
              <span class="slotwire-badge-archetype">🏷️ {archetype || 'cards'} ({childItems.length}) ▾</span>
            </div>

            <!-- In-Situ Multi-Target Popover Menu (Directly connected to trigger) -->
            <div class="slotwire-composite-popover">
              <div class="slotwire-popover-header">
                <span class="slotwire-popover-title">📦 {resolvedCollection}</span>
                <span class="slotwire-popover-badge">{childItems.length} items</span>
              </div>

              <div class="slotwire-popover-list">
                {childItems.map((child, idx) => (
                  <a
                    href={child.editUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="slotwire-popover-item"
                    title={`Edit ${child.label} (${child.id}) in CMS`}
                  >
                    {child.thumbnail ? (
                      <img
                        src={child.thumbnail}
                        alt=""
                        class="slotwire-popover-thumb"
                        onerror="this.style.display='none'"
                      />
                    ) : (
                      <span class="slotwire-popover-item-idx">#{idx + 1}</span>
                    )}
                    <div class="slotwire-popover-item-info">
                      <span class="slotwire-popover-item-label">{child.label}</span>
                      <span class="slotwire-popover-item-id">{child.id}</span>
                    </div>
                    <span class="slotwire-popover-item-action">CMS ↗</span>
                  </a>
                ))}
              </div>

              <div class="slotwire-popover-footer">
                <a
                  href={createItemUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="slotwire-popover-btn slotwire-popover-btn-create"
                >
                  ➕ Add New {archetype === 'cards' ? 'Card' : archetype === 'gallery' ? 'Image' : 'Item'} ↗
                </a>
                <a
                  href={listUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="slotwire-popover-btn slotwire-popover-btn-list"
                >
                  📋 View Full Table ↗
                </a>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={isCollectionSlot ? listUrl : singleEditUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="slotwire-edit-btn"
          >
            <svg class="slotwire-logo-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="4" width="6" height="16" rx="2.5" fill="#0f172a" stroke="#10b981" stroke-width="1.8"/>
              <rect x="16" y="4" width="6" height="16" rx="2.5" fill="#0f172a" stroke="#06b6d4" stroke-width="1.8"/>
              <circle cx="5" cy="8.5" r="1.2" fill="#10b981"/>
              <circle cx="5" cy="15.5" r="1.2" fill="#10b981"/>
              <circle cx="19" cy="8.5" r="1.2" fill="#06b6d4"/>
              <circle cx="19" cy="15.5" r="1.2" fill="#06b6d4"/>
              <path d="M6.5 8.5H17.5" stroke="#10b981" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M6.5 15.5H17.5" stroke="#06b6d4" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>✓ <strong>{slot}</strong></span>
            <span class={`slotwire-status-tag ${statusBadgeClass}`}>{statusBadgeLabel}</span>
            {archetype && <span class="slotwire-badge-archetype">🏷️ {archetype}</span>}
            <span class="slotwire-sep">•</span>
            <span class="slotwire-badge-edit-action">{actionLabel}</span>
          </a>
        )}

        <!-- Quick Edit In-Situ Button -->
        <button
          type="button"
          class="slotwire-badge-quick-edit-btn"
          title={`Quick Edit: ${slot}`}
          aria-label={`Quick Edit: ${slot}`}
          data-slot={slot}
          data-collection={collection}
          data-document-id={documentId || (data && (data.id || data.slug))}
          data-slot-data={serializedSlotData}
          data-edit-url={isCollectionSlot ? listUrl : singleEditUrl}
        >
          <svg class="sw-quick-icon" width="11" height="11" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25a1.75 1.75 0 0 1 .445-.758l8.61-8.61Zm1.414 1.06a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354l-1.086-1.086ZM11.189 6.25 9.75 4.81l-6.286 6.287a.25.25 0 0 0-.064.108l-.558 1.953 1.953-.558a.249.249 0 0 0 .108-.064l6.286-6.286Z"/>
          </svg>
          <span>Quick Edit</span>
        </button>

        <!-- Minimize / Collapse Button -->
        <button
          type="button"
          class="slotwire-badge-minimize-btn"
          title="Minimize badge to tiny icon"
          aria-label="Minimize"
        >
          −
        </button>
      </div>

      <!-- Minimized Floating Icon (Visible when collapsed) -->
      <button
        type="button"
        class="slotwire-badge-minimized-pill"
        title={`Expand SlotWire: ${slot}`}
        aria-label={`Expand SlotWire: ${slot}`}
      >
        <svg class="slotwire-logo-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="4" width="6" height="16" rx="2.5" fill="#0f172a" stroke="#10b981" stroke-width="1.8"/>
          <rect x="16" y="4" width="6" height="16" rx="2.5" fill="#0f172a" stroke="#06b6d4" stroke-width="1.8"/>
          <circle cx="5" cy="8.5" r="1.2" fill="#10b981"/>
          <circle cx="5" cy="15.5" r="1.2" fill="#10b981"/>
          <circle cx="19" cy="8.5" r="1.2" fill="#06b6d4"/>
          <circle cx="19" cy="15.5" r="1.2" fill="#06b6d4"/>
          <path d="M6.5 8.5H17.5" stroke="#10b981" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M6.5 15.5H17.5" stroke="#06b6d4" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
) : (
  isTaggingEnabled ? (
    <Tag
      data-slotwire-slot={slot}
      data-slotwire-archetype={archetype}
      data-slotwire-collection={resolvedCollection}
      data-slotwire-page={pageSlug}
      data-slotwire-section={sectionKey}
      data-slotwire-id={resolvedDocId}
      data-slotwire-source={isFallback ? 'fallback' : 'cms'}
      class={className}
    >
      <slot />
    </Tag>
  ) : (
    <Tag class={className}>
      <slot />
    </Tag>
  )
)}

<style>
  .slotwire-slot-container {
    position: relative;
    transition: outline 0.15s ease-in-out;
  }
  .slotwire-in-situ-badge {
    position: absolute;
    z-index: 9990;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease-in-out, transform 0.2s ease-in-out;
  }

  /* Default Corner Positions */
  .slotwire-in-situ-badge.sw-pos-tr {
    top: 12px;
    right: 12px;
    bottom: auto;
    left: auto;
    transform: translateY(-4px);
  }
  .slotwire-in-situ-badge.sw-pos-br {
    bottom: 12px;
    right: 12px;
    top: auto;
    left: auto;
    transform: translateY(4px);
  }
  .slotwire-in-situ-badge.sw-pos-bl {
    bottom: 12px;
    left: 12px;
    top: auto;
    right: auto;
    transform: translateY(4px);
  }
  .slotwire-in-situ-badge.sw-pos-tl {
    top: 12px;
    left: 12px;
    bottom: auto;
    right: auto;
    transform: translateY(-4px);
  }

  .slotwire-slot-container:hover > .slotwire-in-situ-badge,
  .slotwire-slot-container:focus-within > .slotwire-in-situ-badge {
    opacity: 1;
    pointer-events: none;
    transform: translateY(0);
  }
  .slotwire-slot-container:hover > .slotwire-in-situ-badge .slotwire-badge-card,
  .slotwire-slot-container:hover > .slotwire-in-situ-badge .slotwire-badge-minimized-pill {
    pointer-events: auto;
  }
  .slotwire-slot-container:hover {
    outline: 2px dashed rgba(16, 185, 129, 0.5);
    outline-offset: 4px;
    border-radius: 8px;
  }

  /* Pinned / Force-Visible Overlays (Triggered via Assist Bubble / Inspector) */
  .slotwire-in-situ-badge.sw-force-visible {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }
  .slotwire-in-situ-badge.sw-force-visible .slotwire-badge-card,
  .slotwire-in-situ-badge.sw-force-visible .slotwire-badge-minimized-pill {
    pointer-events: auto !important;
  }
  .slotwire-slot-container.sw-highlight-wireframe {
    outline: 2px dashed rgba(16, 185, 129, 0.85) !important;
    outline-offset: 4px !important;
    border-radius: 8px !important;
  }
  .slotwire-slot-container.sw-flash-locate {
    animation: sw-locate-glow 2.5s ease-out forwards !important;
  }
  @keyframes sw-locate-glow {
    0% {
      outline: 4px solid #10b981 !important;
      box-shadow: 0 0 28px rgba(16, 185, 129, 0.9) !important;
    }
    50% {
      outline: 4px solid #38bdf8 !important;
      box-shadow: 0 0 36px rgba(56, 189, 248, 0.9) !important;
    }
    100% {
      outline: none !important;
      box-shadow: none !important;
    }
  }

  :global(.slotwire-hide-overlays) .slotwire-in-situ-badge,
  :global(.slotwire-hide-overlays) .slotwire-composite-popover {
    display: none !important;
  }
  :global(.slotwire-hide-overlays) .slotwire-slot-container {
    outline: none !important;
  }

  .slotwire-badge-card {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background-color: #09090b !important;
    border: 1px solid rgba(16, 185, 129, 0.6) !important;
    border-radius: 8px;
    padding: 3px 6px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
  }

  .slotwire-badge-drag {
    cursor: grab;
    color: #71717a;
    font-size: 11px;
    padding: 0 4px;
    user-select: none;
  }
  .slotwire-badge-drag:active {
    cursor: grabbing;
    color: #10b981;
  }

  .slotwire-badge-quick-edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 22px;
    box-sizing: border-box;
    padding: 0 8px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 4px;
    color: #34d399;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
  }
  .slotwire-badge-quick-edit-btn .sw-quick-icon {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }
  .slotwire-badge-quick-edit-btn:hover {
    background: rgba(16, 185, 129, 0.3);
    border-color: #10b981;
    color: #ffffff;
    transform: scale(1.03);
  }

  .slotwire-badge-minimize-btn {
    background: #18181b;
    border: 1px solid #27272a;
    color: #a1a1aa;
    border-radius: 4px;
    height: 22px;
    box-sizing: border-box;
    padding: 0 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
    transition: all 0.15s;
  }
  .slotwire-badge-minimize-btn:hover {
    background: #27272a;
    color: #ffffff;
    border-color: #3f3f46;
  }

  .slotwire-badge-minimized-pill {
    display: none;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background-color: #09090b;
    border: 1px solid #10b981;
    border-radius: 9999px;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0,0,0,0.6);
    padding: 0;
  }
  .slotwire-badge-minimized-pill:hover {
    transform: scale(1.1);
    background-color: #059669;
  }

  /* Minimized State */
  .slotwire-in-situ-badge.is-minimized .slotwire-badge-card {
    display: none !important;
  }
  .slotwire-in-situ-badge.is-minimized .slotwire-badge-minimized-pill {
