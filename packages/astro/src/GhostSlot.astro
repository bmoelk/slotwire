---
import type { SlotArchetype } from '@slotwire/core';
import { buildCmsDeepLink } from './deep-link.js';

export interface Props {
  slot: string;
  archetype?: SlotArchetype;
  collection?: string;
  pageSlug?: string;
  sectionKey?: string;
  documentId?: string;
  required?: boolean;
  adminUrl?: string;
  provider?: string;
  class?: string;
}

const {
  slot,
  archetype,
  collection = slot,
  pageSlug,
  sectionKey,
  documentId,
  required = false,
  adminUrl = 'https://cms.brainendeavor.com/admin',
  provider = 'sonicjs',
  class: className = '',
} = Astro.props;

const editUrl = buildCmsDeepLink({
  provider,
  adminUrl,
  collection,
  documentId,
  pageSlug,
  sectionKey,
  action: documentId ? 'edit' : 'create',
});
---

<div
  class={`slotwire-ghost-slot relative my-4 overflow-hidden rounded-2xl border-2 border-dashed border-amber-500/60 bg-amber-500/5 dark:bg-amber-950/25 p-6 text-amber-900 dark:text-amber-200 transition-all duration-200 hover:border-amber-500 hover:bg-amber-500/10 ${className}`}
  data-slotwire-ghost="true"
  data-slotwire-slot={slot}
  data-slotwire-archetype={archetype}
  data-slotwire-collection={collection}
  data-slotwire-page={pageSlug}
  data-slotwire-section={sectionKey}
>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-2.5">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/20 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        Ghost Slot
      </span>

      <span class="font-mono text-xs font-bold text-amber-900 dark:text-amber-100">
        Slot: <code class="rounded bg-amber-200/50 dark:bg-amber-900/60 px-1.5 py-0.5">{slot}</code>
      </span>

      {archetype && (
        <span class="inline-flex items-center rounded-md bg-zinc-200/80 dark:bg-zinc-800/80 px-2 py-0.5 font-mono text-[11px] text-zinc-700 dark:text-zinc-300">
          Archetype: {archetype}
        </span>
      )}

      {required && (
        <span class="inline-flex items-center rounded-md bg-rose-500/15 px-2 py-0.5 text-[11px] font-extrabold uppercase text-rose-700 dark:text-rose-400 border border-rose-500/30">
          Required
        </span>
      )}
    </div>

    <a
      href={editUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-lg bg-amber-600 px-3.5 py-1.5 font-sans text-xs font-semibold text-white shadow-sm transition-transform duration-150 hover:bg-amber-500 hover:scale-[1.02] active:scale-[0.98]"
    >
      <span>+ Add Content in CMS</span>
      <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-amber-800/80 dark:text-amber-300/80 font-mono">
    {collection && <span>Collection: <code>{collection}</code></span>}
    {pageSlug && <span>Page: <code>{pageSlug}</code></span>}
    {sectionKey && <span>Section: <code>{sectionKey}</code></span>}
  </div>

  <p class="mt-2 text-xs text-amber-800/90 dark:text-amber-300/90">
    This slot is currently empty in the CMS database. Live preview mode renders this wireframe to prevent layout collapse.
  </p>

  <div class="mt-4 pt-3 border-t border-amber-500/20 opacity-70">
    <slot name="fallback">
      <slot />
    </slot>
  </div>
</div>
