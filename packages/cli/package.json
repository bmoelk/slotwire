{
  "name": "@slotwire/cli",
  "version": "0.1.0",
  "description": "Automated HTML & AST slot scanner, contract validator, and CI quality gate for SlotWire",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "slotwire": "./bin/slotwire.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@slotwire/core": "file:../core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4"
  },
  "license": "MIT"
}
